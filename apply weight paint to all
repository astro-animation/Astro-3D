import bpy

# Apply Weighted Normal to every mesh object
for obj in bpy.context.scene.objects:
    if obj.type != 'MESH':
        continue

    # Make object active
    bpy.context.view_layer.objects.active = obj
    obj.select_set(True)

    # Add Weighted Normal modifier
    modifier = obj.modifiers.new(name="Weighted Normal", type='WEIGHTED_NORMAL')
    modifier.keep_sharp = True
    modifier.weight = 50

    # Apply modifier
    bpy.ops.object.modifier_apply(modifier=modifier.name)

    obj.select_set(False)
